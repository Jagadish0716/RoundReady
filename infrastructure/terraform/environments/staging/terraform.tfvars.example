project_name = "roundready"
environment  = "staging"
aws_region   = "ap-south-1"
vpc_cidr     = "10.20.0.0/16"
az_count     = 2
nat_gateway_mode = "single"
enable_flow_logs = false
kubernetes_version = "1.33"
node_instance_types = ["t3.medium"]
node_min_size = 2
node_desired_size = 2
node_max_size = 4
node_disk_size = 50
enable_public_eks_endpoint = true
eks_public_access_cidrs = ["203.0.113.0/24"]
enable_eks_control_plane_logs = true

common_tags = {
  CostCenter = "staging"
}
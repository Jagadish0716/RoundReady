project_name = "roundready"
environment  = "production"
aws_region   = "REQUIRED"
vpc_cidr     = "10.30.0.0/16"
az_count     = 3
nat_gateway_mode = "one_per_az"
enable_flow_logs = true
kubernetes_version = "1.33"
node_instance_types = ["t3.medium"]
node_min_size = 2
node_desired_size = 2
node_max_size = 6
node_disk_size = 50
enable_public_eks_endpoint = false
eks_public_access_cidrs = []
enable_eks_control_plane_logs = true
rds_postgres_version = "16"
rds_instance_class = "db.t4g.medium"
rds_allocated_storage = 100
rds_max_allocated_storage = 500
rds_multi_az = true
rds_backup_retention_days = 14
rds_deletion_protection = true
rds_skip_final_snapshot = false
rds_apply_immediately = false
rds_performance_insights_enabled = true
rds_monitoring_interval = 60
rds_cloudwatch_log_exports = ["postgresql"]
managed_secret_recovery_window_days = 30
redis_engine = "valkey"
redis_engine_version = "8.0"
redis_node_type = "cache.t4g.small"
redis_replica_count = 1
redis_multi_az = true
redis_snapshot_retention_days = 3
redis_apply_immediately = false
rabbitmq_engine_version = "3.13"
rabbitmq_instance_type = "mq.m5.large"
rabbitmq_deployment_mode = "CLUSTER_MULTI_AZ"
rabbitmq_general_log_enabled = true
rabbitmq_apply_immediately = false
load_balancer_controller_enabled = true
load_balancer_controller_version = "v2.14.1"
public_ingress_enabled = true
# Set either hosted_zone_id or hosted_zone_name to an existing public Route 53 zone.
hosted_zone_id = null
hosted_zone_name = null
# Explicit production hostnames are required before planning this environment.
frontend_domain = null
api_domain = null
# Populate both only after the Kubernetes controller creates the shared public ALB.
public_alb_dns_name = null
public_alb_zone_id = null
application_namespace = "roundready"
create_pod_identity_associations = true
ecr_image_tag_mutability = "IMMUTABLE"
ecr_scan_on_push = true
ecr_tagged_image_retention_count = 30
ecr_untagged_retention_days = 14
ecr_force_delete = false
application_log_retention_days = 90
aws_native_alarms_enabled = true
rds_cpu_alarm_threshold_percent = 80
rds_free_storage_alarm_bytes = 10737418240

common_tags = {
  CostCenter = "production"
}

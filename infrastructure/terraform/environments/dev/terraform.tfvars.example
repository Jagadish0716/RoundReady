project_name = "roundready"
environment  = "dev"
aws_region   = "ap-south-1"
vpc_cidr     = "10.10.0.0/16"
az_count     = 2
nat_gateway_mode = "single"
enable_flow_logs = false
k3s_instance_type = "t4g.small"
k3s_root_volume_size = 30
k3s_ami_ssm_parameter = "/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
ec2_key_name = "geekyants"
rds_postgres_version = "16"
rds_instance_class = "db.t4g.micro"
rds_allocated_storage = 20
rds_max_allocated_storage = 100
rds_multi_az = false
rds_backup_retention_days = 1
rds_deletion_protection = false
rds_skip_final_snapshot = true
rds_apply_immediately = true
rds_performance_insights_enabled = false
rds_monitoring_interval = 0
rds_cloudwatch_log_exports = []
managed_secret_recovery_window_days = 0
redis_engine = "valkey"
redis_engine_version = "8.0"
redis_node_type = "cache.t4g.micro"
redis_replica_count = 0
redis_multi_az = false
redis_snapshot_retention_days = 0
redis_apply_immediately = true
rabbitmq_engine_version = "3.13"
rabbitmq_instance_type = "mq.t3.micro"
rabbitmq_deployment_mode = "SINGLE_INSTANCE"
rabbitmq_general_log_enabled = true
rabbitmq_apply_immediately = true
ecr_image_tag_mutability = "IMMUTABLE"
ecr_scan_on_push = true
ecr_tagged_image_retention_count = 10
ecr_untagged_retention_days = 7
ecr_force_delete = true
application_log_retention_days = 7
aws_native_alarms_enabled = false

common_tags = {
  CostCenter = "development"
}

# Application
# One of: development, test, production. This example is intentionally development-only.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Shared only between the API gateway and internal services; use a random secret locally.
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-random-bytes
# Separate credential for service-to-service endpoints (for example notification → user).
INTERNAL_SERVICE_SECRET=replace-with-another-32-random-bytes
# Direct-host gateway alias; it must equal INTERNAL_SERVICE_SECRET.
NOTIFICATION_INTERNAL_IDENTITY_SECRET=replace-with-another-32-random-bytes
API_GATEWAY_PORT=8000
CORS_ORIGINS=[]
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Required for RS256; leave empty for HS256 so the signing key is also used to verify.
JWT_VERIFICATION_KEY=
JWT_ISSUER=roundready-auth
JWT_AUDIENCE=roundready-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# PostgreSQL infrastructure administrator (never use from an application)
POSTGRES_ADMIN_USER=roundready_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-admin
POSTGRES_ADMIN_DB=postgres
POSTGRES_PORT=5432

# One owner role and database per persistent service
AUTH_DB_NAME=roundready_auth
AUTH_DB_USER=roundready_auth
AUTH_DB_PASSWORD=change-me-local-auth
USER_DB_NAME=roundready_user
USER_DB_USER=roundready_user
USER_DB_PASSWORD=change-me-local-user
INTERVIEWER_DB_NAME=roundready_interviewer
INTERVIEWER_DB_USER=roundready_interviewer
INTERVIEWER_DB_PASSWORD=change-me-local-interviewer
BOOKING_DB_NAME=roundready_booking
BOOKING_DB_USER=roundready_booking
BOOKING_DB_PASSWORD=change-me-local-booking
PAYMENT_DB_NAME=roundready_payment
PAYMENT_DB_USER=roundready_payment
PAYMENT_DB_PASSWORD=change-me-local-payment
INTERVIEW_DB_NAME=roundready_interview
INTERVIEW_DB_USER=roundready_interview
INTERVIEW_DB_PASSWORD=change-me-local-interview
NOTIFICATION_DB_NAME=roundready_notification
NOTIFICATION_DB_USER=roundready_notification
NOTIFICATION_DB_PASSWORD=change-me-local-notification

# Service-owned SQLAlchemy URLs for applications running on the host
AUTH_DATABASE_URL=postgresql+asyncpg://roundready_auth:change-me-local-auth@localhost:5432/roundready_auth
USER_DATABASE_URL=postgresql+asyncpg://roundready_user:change-me-local-user@localhost:5432/roundready_user
INTERVIEWER_DATABASE_URL=postgresql+asyncpg://roundready_interviewer:change-me-local-interviewer@localhost:5432/roundready_interviewer
BOOKING_DATABASE_URL=postgresql+asyncpg://roundready_booking:change-me-local-booking@localhost:5432/roundready_booking
PAYMENT_DATABASE_URL=postgresql+asyncpg://roundready_payment:change-me-local-payment@localhost:5432/roundready_payment
INTERVIEW_DATABASE_URL=postgresql+asyncpg://roundready_interview:change-me-local-interview@localhost:5432/roundready_interview
NOTIFICATION_DATABASE_URL=postgresql+asyncpg://roundready_notification:change-me-local-notification@localhost:5432/roundready_notification

# Shared SQLAlchemy pool defaults; each service may override these independently
DATABASE_POOLING=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Redis: shared server, isolated logical DB number per service
REDIS_PASSWORD=change-me-local-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-redis@localhost:6379/0
BOOKING_REDIS_URL=redis://:change-me-local-redis@localhost:6379/2

# RabbitMQ transport and application-owned topology names
RABBITMQ_USER=roundready
RABBITMQ_PASSWORD=change-me-local-rabbitmq
RABBITMQ_VHOST=roundready
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://roundready:change-me-local-rabbitmq@localhost:5672/roundready
RABBITMQ_EXCHANGE=roundready.events
AUTH_EVENT_QUEUE=roundready.auth.events
USER_EVENT_QUEUE=roundready.user.events
INTERVIEWER_EVENT_QUEUE=roundready.interviewer.events
BOOKING_EVENT_QUEUE=roundready.booking.events
PAYMENT_EVENT_QUEUE=roundready.payment.events
INTERVIEW_EVENT_QUEUE=roundready.interview.events
NOTIFICATION_EVENT_QUEUE=roundready.notification.events
RABBITMQ_DEAD_LETTER_EXCHANGE=roundready.events.dlx

# Internal REST locations when applications run directly on the host
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
INTERVIEWER_SERVICE_URL=http://localhost:8003
BOOKING_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005
INTERVIEW_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007

# Local development payment provider and Razorpay test placeholders
PAYMENT_PROVIDER=development
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_TEST_MODE=true
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# LiveKit local/development credentials only; recording remains disabled
VIDEO_PROVIDER=development
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me-local-livekit-secret
LIVEKIT_TEST_MODE=true
PARTICIPANT_TOKEN_TTL_SECONDS=300

# Development notification providers (no external delivery)
EMAIL_PROVIDER=development
WHATSAPP_PROVIDER=development
# Production Resend email configuration (placeholders are unused in development)
RESEND_API_BASE_URL=https://api.resend.com
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM_ADDRESS=RoundReady <notifications@example.invalid>
# Production Meta WhatsApp Cloud API configuration
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_TEMPLATE_NAME=replace-with-approved-template-name
WHATSAPP_TEMPLATE_LANGUAGE=en
PROVIDER_TIMEOUT_SECONDS=10
